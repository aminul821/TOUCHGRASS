# Bot token from @BotFather
BOT_TOKEN=

# Ollama server with an open-weight model (https://ollama.com): `ollama pull gemma3:4b`
OLLAMA_URL=http://localhost:11434
# Use a vision model (gemma3, qwen2.5vl, llava…) so /touched can check photos
OLLAMA_MODEL=gemma3:4b

# How far to look for parks, trails and viewpoints, in metres
SEARCH_RADIUS=3000
# Minutes before sunset for the daily golden-hour nudge (0 = off)
NUDGE_BEFORE_SUNSET=120
# Optional: only work in these chat ids (space or comma separated)
ALLOWED_CHATS=
DATA_PATH=data/touchgrass.json
